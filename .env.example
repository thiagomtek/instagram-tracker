# Porta publicada no host (o app fica disponível em http://HOST:8080 por padrão)
APP_PORT=8080

# Gere com: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value

# Usados uma única vez para criar a primeira conta no banco. Depois da
# inicialização você pode remover INITIAL_ADMIN_PASSWORD deste arquivo.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-your-first-password

# Cadastro fechado por padrão (a primeira conta sempre pode ser criada).
# Use true somente enquanto precisar criar contas novas.
ALLOW_REGISTRATION=false

# Em produção/PWA use HTTPS e mantenha true. Para desenvolvimento em http://localhost, use false.
SESSION_COOKIE_SECURE=true
SESSION_DAYS=3650
TRUST_PROXY_HEADERS=true

# Bloqueio de login: após N falhas, o par (IP, e-mail) fica bloqueado por N segundos.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# Google Cloud Console > APIs e serviços > Credenciais (cliente OAuth do tipo Web)
# Ative a Google Drive API e cadastre exatamente esta URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tracker.example.com/integrations/google/callback

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_SETTLE_SECONDS=300
GOOGLE_DRIVE_MAX_ITEMS=10000
# trash = envia a pasta processada para a lixeira do Drive (recuperável).
# delete = exclui permanentemente.
GOOGLE_DRIVE_DELETE_MODE=trash

# Proteções de importação: uma exportação que removeria esta fração (e pelo menos
# este número) de perfis da lista é recusada até o usuário confirmar. A mesma
# exportação reenviada dentro da janela é ignorada.
IMPORT_MASS_DROP_RATIO=0.3
IMPORT_MASS_DROP_MIN=20
IMPORT_DUPLICATE_WINDOW_HOURS=12

# Validação de perfis sumidos consultando perfis públicos no Instagram (worker).
# Defina false para nunca consultar o Instagram; a remoção só será confirmada
# quando a outra lista (seguidores/seguindo) provar que a conta existe.
PROFILE_VALIDATION_ENABLED=true

# Gere o par uma única vez com: python scripts/generate_vapid_keys.py
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Identidade própria evita que a instalação seja confundida com outro PWA no mesmo navegador.
PWA_ID=/instagram-tracker-pwa
APP_TIMEZONE=America/Sao_Paulo
